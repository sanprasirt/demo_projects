# Copy to .env before `docker compose --profile mock up --build`.
# Compose reads COMPOSE_PROFILES from this file.

COMPOSE_PROFILES=mock

# Agent UI and links embedded in Teams cards (opened by a browser on the host).
AGENT_PUBLIC_URL=http://localhost:8080
GRAFANA_PUBLIC_URL=http://localhost:3000
GITLAB_PUBLIC_URL=http://localhost:8929

# Teams Workflows incoming webhook. The mock receiver is the local default.
TEAMS_WEBHOOK_URL=http://mock-teams:8090/webhook

# GitLab. Point GITLAB_URL at an internal instance and drop the mock profile's
# gitlab service when you run `--profile gitlab` instead.
GITLAB_URL=http://mock-gitlab:8929
GITLAB_PROJECT_ID=1
GITLAB_PROJECT_PATH=shop/day2-demo
GITLAB_READ_TOKEN=glpat-read-demo
GITLAB_WRITE_TOKEN=glpat-write-demo
GITLAB_WEBHOOK_TOKEN=demo-webhook

# LLM. Mock OpenAI-compatible server, or vLLM when the gpu profile is up.
LLM_BASE_URL=http://mock-llm:8000/v1
LLM_MODEL=mock-sre
LLM_API_KEY=dummy
# 24GB GPU default. For a 16GB GPU set VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# and LLM_MODEL to the same value, with LLM_BASE_URL=http://vllm:8000/v1.
VLLM_MODEL=Qwen/Qwen3-14B-AWQ

# Shop admin token for /admin/failmode and /admin/db. The agent sends it only after approval.
ADMIN_TOKEN=demo-admin

# Shop Postgres. These match the compose service. GitLab CE has its own database.
DATABASE_URL=postgresql://shop_app:shop_app@postgres:5432/shop
PG_READ_DSN=postgresql://sre_ro:sre_ro@postgres:5432/shop
PG_WRITE_DSN=postgresql://sre_writer:sre_writer@postgres:5432/shop
# Rows joined into the missing-index scan, and the series count for scenario 3.
# 30 passes is slow enough to page DBSlowQueries without also paging latency.
# 2500000 series is about 1.8s, above the latency alert and the slow log line.
SLOW_PASSES=30
FAIL_LATENCY_SERIES=2500000

# Set to 0 to skip NeMo and keep the Python execution rail only.
ENABLE_NEMO=1
OPENAI_API_KEY=dummy
