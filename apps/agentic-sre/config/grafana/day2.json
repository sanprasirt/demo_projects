{
  "uid": "day2",
  "title": "Day-2 operations",
  "tags": ["sre", "demo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "links": [
    {
      "title": "PostgreSQL",
      "url": "/d/postgres/postgresql",
      "type": "link",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by service and status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, status) (rate(demo_http_requests_total[1m]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Catalog 5xx rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "fixed", "fixedColor": "red"}}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_http_requests_total{service=\"catalog\",status=~\"5..\"}[1m]))",
          "legendFormat": "catalog 5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Injected leak bytes",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (demo_memory_bytes)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dependency latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, dependency) (rate(demo_dependency_latency_seconds_sum[1m])) / sum by (service, dependency) (rate(demo_dependency_latency_seconds_count[1m]))",
          "legendFormat": "{{service}} {{dependency}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "text",
      "title": "Database",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 16},
      "options": {
        "mode": "markdown",
        "content": "Catalog and checkout use PostgreSQL 16. Open the [PostgreSQL dashboard](/d/postgres/postgresql) for connections, locks, cache hit ratio, tuples, and statement time."
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres connections",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "links": [{"title": "PostgreSQL dashboard", "url": "/d/postgres/postgresql", "keepTime": true}],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (demo_pg_connections_count{datname=\"shop\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Postgres lock waits",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "links": [{"title": "PostgreSQL dashboard", "url": "/d/postgres/postgresql", "keepTime": true}],
      "targets": [
        {
          "refId": "A",
          "expr": "sum(demo_pg_activity_lock_waits)",
          "legendFormat": "lock waits"
        },
        {
          "refId": "B",
          "expr": "sum(demo_pg_locks_waiting)",
          "legendFormat": "locks not granted"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "orders_by_sku time",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "links": [{"title": "PostgreSQL dashboard", "url": "/d/postgres/postgresql", "keepTime": true}],
      "targets": [
        {
          "refId": "A",
          "expr": "max(demo_db_last_query_seconds{statement=\"orders_by_sku\"})",
          "legendFormat": "last orders_by_sku"
        },
        {
          "refId": "B",
          "expr": "max(demo_pg_statements_mean_seconds{query=~\".*orders_by_sku.*\"})",
          "legendFormat": "pg_stat_statements mean"
        }
      ]
    }
  ]
}
