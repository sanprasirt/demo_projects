{
  "uid": "day2",
  "title": "Day-2 operations",
  "tags": ["sre", "demo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by service and status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, status) (rate(demo_http_requests_total[1m]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Catalog 5xx rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "fixed", "fixedColor": "red"}}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_http_requests_total{service=\"catalog\",status=~\"5..\"}[1m]))",
          "legendFormat": "catalog 5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Injected leak bytes",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (demo_memory_bytes)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dependency latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, dependency) (rate(demo_dependency_latency_seconds_sum[1m])) / sum by (service, dependency) (rate(demo_dependency_latency_seconds_count[1m]))",
          "legendFormat": "{{service}} {{dependency}}"
        }
      ]
    }
  ]
}
